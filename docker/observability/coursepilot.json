{
  "uid": "coursepilot-overview",
  "title": "CoursePilot - Execution and Evidence",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["coursepilot"],
  "panels": [
    {
      "id": 1, "title": "Runs by execution status (not model quality)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "coursepilot-prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by(status) (increase(coursepilot_agent_runs_total[5m]))", "legendFormat": "{{status}}"}]
    },
    {
      "id": 2, "title": "First validated answer segment (seconds)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "coursepilot-prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.5, sum by(le) (rate(coursepilot_agent_ttft_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by(le) (rate(coursepilot_agent_ttft_seconds_bucket[5m])))", "legendFormat": "p95"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 3, "title": "Stage duration p95 (seconds)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "coursepilot-prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by(le, stage) (rate(coursepilot_stage_duration_seconds_bucket[5m])))", "legendFormat": "{{stage}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 4, "title": "Tool calls by status", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "coursepilot-prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "sum by(tool, status) (increase(coursepilot_tool_calls_total[5m]))", "legendFormat": "{{tool}} {{status}}"}]
    },
    {
      "id": 5, "title": "Completed run latency p95 (seconds)", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "coursepilot-prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by(le) (rate(coursepilot_agent_run_duration_seconds_bucket[5m])))", "legendFormat": "p95"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 6, "title": "Retrieved chunk count p50", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "coursepilot-prometheus"},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.5, sum by(le) (rate(coursepilot_retrieval_results_bucket[5m])))", "legendFormat": "chunks"}]
    }
  ]
}
