DATABASE_URL=postgresql+asyncpg://coursepilot:coursepilot@postgres:5432/learning_platform
CHECKPOINT_DATABASE_URL=postgresql://coursepilot:coursepilot@postgres:5432/learning_platform?options=-csearch_path%3Dagent%2Cpublic
AGENT_INTERNAL_SECRET=replace-with-at-least-32-random-characters
AGENT_JWT_ISSUER=learnhub-web
AGENT_JWT_AUDIENCE=coursepilot-agent
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0.2
LLM_DISABLE_THINKING=false
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=25
MAX_TOOL_ITERATIONS=4
UPLOADS_DIR=/data/public
ALLOWED_CONTENT_HOSTS=amazonaws.com,digitaloceanspaces.com
MAX_PDF_BYTES=20000000
MAX_PDF_PAGES=300
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
LANGGRAPH_STRICT_MSGPACK=true
